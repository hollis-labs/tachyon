{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@planner/*": ["src/planner/*"],
      "@console/*": ["src/console/*"],
      "@tachyon/torque-client": ["src/packages/torque-client/src/index.ts"],
      "@tachyon/host-sdk": ["src/packages/host-sdk/src/index.ts"]
    }
  },
  "include": ["src", "e2e", "tests", "playwright.config.ts", "vite.config.ts", "vitest.config.ts"]
}
