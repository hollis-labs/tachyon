# Go binary built from `make build`
/tachyon

# Cerberus creates this transient lock before checking source freshness.
/.cerberus-build.lock

# Go test + build artefacts
*.exe
*.test
*.out
coverage.out

# Frontend
frontend/node_modules/
frontend/dist/

# Built Sysop UI assets — produced by `make ui-build`, embedded by Go.
# The dist/ directory and its .gitkeep are kept so `//go:embed` compiles.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local env
.env
.env.local

# Plugin binaries
/bin/

# Root workspace deps
/node_modules/
