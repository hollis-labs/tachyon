#!/usr/bin/env bash
# Replay a chat thread event stream, with resume. Works against the stub
# (TACHYON_CHAT_STUBS=1) and, later, the real routes.
#   scripts/chat-sse-replay [-b BASE] [-r THREAD_REF] [-l LAST_EVENT_ID] [-1]
#     -b base URL           (default http://127.0.0.1:8080)
#     -r thread_ref         (default app:t_01; "-" = global /chat/events)
#     -l Last-Event-ID      resume after this id
#     -1                    stop after the replay (stub: ?once=1)
# Operator-only routes need a session: export TACHYON_COOKIE='name=value'.
set -euo pipefail
base=http://127.0.0.1:8080 ref=app:t_01 last="" once=""
while getopts b:r:l:1 o; do case $o in b) base=$OPTARG;; r) ref=$OPTARG;; l) last=$OPTARG;; 1) once="?once=1";; *) exit 2;; esac; done
p=/api/plugins/console/v1/chat
if [ "$ref" = "-" ]; then url="$base$p/events$once"; else url="$base$p/threads/$ref/events$once"; fi
args=(-sS -N -H 'Accept: text/event-stream')
[ -n "$last" ] && args+=(-H "Last-Event-ID: $last")
[ -n "${TACHYON_COOKIE:-}" ] && args+=(-H "Cookie: $TACHYON_COOKIE")
exec curl "${args[@]}" "$url"
