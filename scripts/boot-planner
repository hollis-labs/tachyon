#!/usr/bin/env python3
"""Launch the approved Tachyon Planner profile through the Tether hub CLI.

The catalog owns the agent's prompt, permissions and private token-file path.
Only non-secret launch selectors are passed over SSH; no credential is copied.
"""
import argparse
import shlex
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--hub', default='chrispian@100.74.49.44')
    parser.add_argument('--tether-binary', default='/var/lib/fabric/bin/tether')
    parser.add_argument('--catalog', default='/var/lib/fabric/tether/catalog')
    parser.add_argument('--worker', default='agent-os')
    parser.add_argument('--launch', default='tachyon-planner')
    parser.add_argument('--key', default='tachyon-planner-read-v1',
                        help='retained launch key; change to start an additional planner')
    parser.add_argument('--replace', action='store_true',
                        help='replace an ended session; a live session refuses replacement')
    parser.add_argument('--print-command', action='store_true',
                        help='show the non-secret launch command without launching')
    args = parser.parse_args()
    if args.hub.startswith('-'):
        parser.error('--hub must be an SSH destination, not an option')
    remote = [args.tether_binary, '--catalog', args.catalog, 'launch',
              '--launch', args.launch, '--worker', args.worker,
              '--idempotency-key', args.key]
    if args.replace:
        remote.append('--replace')
    # SSH joins remote arguments into a shell command, so quote that command
    # explicitly; subprocess alone does not protect remote argument boundaries.
    command = ['ssh', '-T', '-o', 'BatchMode=yes', args.hub, shlex.join(remote)]
    if args.print_command:
        print(shlex.join(command))
        return 0
    return subprocess.call(command)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except OSError:
        print('Could not start SSH; check the hub connection and installed CLI.', file=sys.stderr)
        sys.exit(1)
