{
  "name": "tachyon",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/*",
    "plugins/*/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w frontend",
    "lint:builder": "eslint --config eslint.builder.config.js plugins/console/ui/src/agents plugins/console/ui/src/objects",
    "lint:planner": "eslint --config eslint.planner.config.js plugins/planner/ui/src",
    "lint:cards": "eslint --config eslint.cards.config.js plugins/console/ui/src/alerts plugins/console/ui/src/cards",
    "lint:operations": "eslint --config eslint.operations.config.js plugins/console/ui/src/transcripts/page.tsx plugins/console/ui/src/transcripts/detail.tsx plugins/console/ui/src/approvals/page.tsx plugins/console/ui/src/approvals/dialog.tsx plugins/console/ui/src/forge/inbox/PendingPrInbox.tsx plugins/console/ui/src/forge/inbox/AssignDialog.tsx"
  }
}
